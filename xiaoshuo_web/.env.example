# Copy to .env. Model downloads are explicit, never done at app import.
NOVEL_MODEL_PROVIDER=ollama
NOVEL_BASE_URL=http://127.0.0.1:11434
NOVEL_MAP_MODEL=qwen3.5:4b
NOVEL_REDUCE_MODEL=qwen3.5:9b
NOVEL_VERIFY_MODEL=qwen3.5:9b
NOVEL_MODEL_TIMEOUT=180
NOVEL_MODEL_RETRIES=2
NOVEL_CONTEXT_TOKENS=32768
NOVEL_MAX_OUTPUT_TOKENS=4096
NOVEL_MAX_PROMPT_CHARS=24000
NOVEL_CACHE_ENABLED=1
NOVEL_CHUNK_CHARS=6000
NOVEL_REDUCE_INPUT_CHARS=18000

# Optional: cloud synthesis + verification (quotes are sent to that provider).
# NOVEL_REDUCE_PROVIDER=compatible
# NOVEL_REDUCE_BASE_URL=https://api.deepseek.com
# NOVEL_REDUCE_MODEL=deepseek-v4-pro
# NOVEL_REDUCE_API_KEY=your-key
# NOVEL_REDUCE_THINKING=disabled
# NOVEL_VERIFY_PROVIDER=compatible
# NOVEL_VERIFY_BASE_URL=https://api.deepseek.com
# NOVEL_VERIFY_MODEL=deepseek-v4-pro
# NOVEL_VERIFY_API_KEY=your-key
# NOVEL_VERIFY_THINKING=disabled
